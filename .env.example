# =====================================================================
# PI² — Variáveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores conforme necessário.
# =====================================================================

# Ativa o modo simulado (mock). Enquanto não existe back-end, mantenha "true".
# Quando a API real estiver pronta, basta trocar para "false".
VITE_USE_MOCKS=true

# URL base da API REST real (usada apenas quando VITE_USE_MOCKS=false).
VITE_API_URL=http://localhost:3000/api
